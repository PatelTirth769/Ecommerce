# Copy this file to .env and fill in real values. Never commit .env.

# Razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server
PORT=3636
FRONTEND_URL=

# Firebase (Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Absolute or relative path to a Firebase service-account JSON key file.
# Keep this file outside git (see backend/secrets/ in .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ERPNext integration user (dedicated API key/secret, NOT the Administrator account)
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_MODE_OF_PAYMENT=Razorpay
ERPNEXT_AUTO_CREATE_DELIVERY_NOTE=false

# Misc
PAYMENT_SYNC_INLINE_TIMEOUT_MS=12000
ADMIN_RETRY_KEY=
